# ==============================================================================
# STAY PRO - AMBIENTE & VARIÁVEIS DE SEGURANÇA (LGPD / OBRIGATÓRIAS)
# ==============================================================================

# ENCRYPTION_MASTER_KEY: Chave mestre de 32 bytes (256 bits) para derivação PBKDF2 e cifra AES-256 de dados sensíveis (CPFs).
# Gerar chave segura via terminal: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# JWT_SECRET: Chave secreta de alta entropia para assinatura e rotação de tokens JWT (Access Token 15min / Refresh 7d).
JWT_SECRET=

# ALLOWED_ORIGINS: Lista de domínios permitidos pelo CORS (separados por vírgula em produção).
ALLOWED_ORIGINS=https://localhost:3000,https://staypro.com.br

# BACKUP_RETENTION_DAYS: Período de retenção em dias para os backups criptografados (padrão: 30).
BACKUP_RETENTION_DAYS=30

# WEBHOOK_SECURITY_URL: URL do Webhook externo para disparo de alertas de Alto Risco (SIEM / Slack / Teams).
WEBHOOK_SECURITY_URL=

# NODE_ENV: Modo de execução ('development' ou 'production').
NODE_ENV=development

# GEMINI_API_KEY: Chave para recursos de IA no servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública onde a aplicação está hospedada.
APP_URL="MY_APP_URL"

# ==============================================================================
# BANCO DE DADOS GOOGLE CLOUD FIRESTORE
# ==============================================================================
FIREBASE_PROJECT_ID=project-6d7775f6-2fcd-4966-b77
FIRESTORE_DATABASE_ID=ai-studio-staypro-8b62f2bf-79f5-4d3c-ad04-6af07de45f4b

# ==============================================================================
# CONFIGURAÇÃO DE SERVIÇO DE E-MAIL (SMTP / NOTIFICAÇÕES & RECUPERAÇÃO)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
